{
    "version": "0.2.0",
    "configurations": [
        {
            // Open a recipe .toml, then F5 to debug the pipeline running it.
            "name": "CLI: run current recipe",
            "type": "debugpy",
            "request": "launch",
            "module": "tensorez",
            "args": ["run", "${file}", "--pretty"],
            "cwd": "${workspaceFolder}/cli",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "CLI: run jupiter example",
            "type": "debugpy",
            "request": "launch",
            "module": "tensorez",
            "args": ["run", "examples/jupiter.toml", "--pretty"],
            "cwd": "${workspaceFolder}/cli",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "CLI: run jupiter deconv example",
            "type": "debugpy",
            "request": "launch",
            "module": "tensorez",
            "args": ["run", "examples/jupiter_deconv.toml", "--pretty"],
            "cwd": "${workspaceFolder}/cli",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            // Debugs the Electron main process; renderer devtools are
            // available in-app via Ctrl+Shift+I.
            "name": "GUI: Electron",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/gui",
            "runtimeExecutable": "${workspaceFolder}/gui/node_modules/.bin/electron",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/gui/node_modules/.bin/electron.cmd"
            },
            "args": ["."],
            "outputCapture": "std",
            "env": {
                "TENSOREZ_PYTHON": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        },
        {
            // Browser-hosted renderer with the mock bridge at http://localhost:8123/
            "name": "GUI: dev server (mock bridge)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/gui",
            "program": "${workspaceFolder}/gui/dev-server.mjs",
            "outputCapture": "std"
        }
    ]
}
